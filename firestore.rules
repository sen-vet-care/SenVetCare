rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'contact@senvetcare.com' ||
        request.auth.token.email == 'senvetcare@gmail.com' ||
        request.auth.token.email == 'drtbsmemorialvetclinic@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      ); 
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidUser(data) {
      return data.keys().hasAll(['email']) 
        && data.email is string 
        && data.email.size() <= 200;
    }

    function isValidPet(data) {
      return true;
    }

    function isValidAppointment(data) {
      return true;
    }

    function isValidMedicalRecord(data) {
      return data.keys().hasAll(['petId', 'vetId', 'date'])
        && data.petId is string
        && data.vetId is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming());
      allow update: if isOwner(userId)
                    && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogs/{blogId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pets/{petId} {
      allow get: if isOwner(existing().ownerId) || isAdmin() || exists(/databases/$(database)/documents/doctors/$(request.auth.uid));
      allow list: if isOwner(resource.data.ownerId) || isAdmin() || exists(/databases/$(database)/documents/doctors/$(request.auth.uid));
      allow create: if (isOwner(incoming().ownerId) || isAdmin())
                    && isValidId(petId)
                    && isValidPet(incoming());
      allow update: if (isOwner(existing().ownerId) || isAdmin())
                    && isValidPet(incoming())
                    && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(existing().ownerId) || isAdmin();
    }

    match /medical_records/{recordId} {
      allow get: if isAdmin() || exists(/databases/$(database)/documents/doctors/$(request.auth.uid)) || (isSignedIn() && get(/databases/$(database)/documents/pets/$(existing().petId)).data.ownerId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.vetId == request.auth.uid) || (isSignedIn() && get(/databases/$(database)/documents/pets/$(resource.data.petId)).data.ownerId == request.auth.uid);
      allow create, update, delete: if isAdmin() || exists(/databases/$(database)/documents/doctors/$(request.auth.uid));
    }

    match /appointments/{appointmentId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /triage_reports/{reportId} {
      allow get: if isOwner(existing().ownerId) || isAdmin() || exists(/databases/$(database)/documents/doctors/$(request.auth.uid));
      allow list: if isOwner(resource.data.ownerId) || isAdmin() || exists(/databases/$(database)/documents/doctors/$(request.auth.uid));
      allow create: if isOwner(incoming().ownerId) || isAdmin();
      allow update: if false; // Reports should be immutable
      allow delete: if isAdmin();
    }
  }
}
