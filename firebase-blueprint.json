{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Information about a doctor in the clinic",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "image_url": { "type": "string" },
        "availability_status": { "type": "string" }
      },
      "required": ["name"]
    },
    "Blog": {
      "title": "Blog",
      "description": "Blog post data",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "author_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content"]
    },
    "Pet": {
      "title": "Pet",
      "description": "Information about a pet",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "species": { "type": "string" },
        "breed": { "type": "string" },
        "ownerId": { "type": "string" },
        "age": { "type": "number" },
        "weight": { "type": "number" }
      },
      "required": ["name", "ownerId"]
    },
    "MedicalRecord": {
      "title": "Medical Record",
      "description": "A veterinary medical record or appointment",
      "type": "object",
      "properties": {
        "petId": { "type": "string" },
        "vetId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "diagnosis": { "type": "string" },
        "treatment": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["petId", "vetId", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Users"
    },
    "/doctors/{doctorId}": {
      "schema": { "$ref": "#/entities/Doctor" },
      "description": "Doctors list"
    },
    "/blogs/{blogId}": {
      "schema": { "$ref": "#/entities/Blog" },
      "description": "Blog posts"
    },
    "/pets/{petId}": {
      "schema": { "$ref": "#/entities/Pet" },
      "description": "Pets"
    },
    "/medical_records/{recordId}": {
      "schema": { "$ref": "#/entities/MedicalRecord" },
      "description": "Medical records and appointments"
    }
  }
}
