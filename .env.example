# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: For sending emails (Contact Form, Triage Reports)
RESEND_API_KEY="MY_RESEND_API_KEY"

# OPENROUTER_API_KEY: OpenRouter fallback key.
OPENROUTER_API_KEY="MY_OPENROUTER_KEY"

# MISTRAL_API_KEY: Mistral AI fallback key.
MISTRAL_API_KEY="MY_MISTRAL_API_KEY"

# NVIDIA_API_KEY: Nvidia generative AI fallback key.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Admin SDK Configuration (Required if deploying custom backend to Vercel/Cloud functions for the Blog Cron)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-firebase-service-account-email"
FIREBASE_PRIVATE_KEY="your-firebase-service-account-private-key-with-newline-chars"
